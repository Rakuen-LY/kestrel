{
  "name": "@kestrel/plugin-anthropic",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Anthropic Messages API provider: streaming text, thinking, tool use and images.",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kestrel/agent": "workspace:*",
    "@kestrel/kernel": "workspace:*",
    "@kestrel/protocol": "workspace:*"
  }
}
