{
  "name": "@kestrel/plugin-browser",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Headless Chromium browsing tools for the Kestrel agent.",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config ../../tsup.plugin.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kestrel/agent": "workspace:*",
    "@kestrel/kernel": "workspace:*"
  }
}
