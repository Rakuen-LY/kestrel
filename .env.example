# Copy to .env and adjust. Never commit .env.
KESTREL_TOKEN=change-me-to-a-long-random-string
# Or enable per-user accounts and bootstrap the first administrator:
# KESTREL_AUTH_MODE=accounts
# KESTREL_BOOTSTRAP_TOKEN=change-me-to-another-long-random-string
KESTREL_MODEL=gpt-4o-mini
KESTREL_WORKSPACE=.
KESTREL_DATA_DIR=.kestrel
KESTREL_LOG_LEVEL=info

# Provider credentials (read by @kestrel/plugin-openai)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=
