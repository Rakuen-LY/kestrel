# /etc/kestrel/kestrel.env — readable by the kestrel service account only.
# chmod 600 /etc/kestrel/kestrel.env
KESTREL_HOST=127.0.0.1
KESTREL_PORT=7331
KESTREL_TOKEN=replace-with-a-long-random-token
KESTREL_WORKSPACE=/srv/workspace
KESTREL_DATA_DIR=/var/lib/kestrel
KESTREL_LOG_LEVEL=info
KESTREL_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
